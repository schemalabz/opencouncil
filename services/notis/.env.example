# Anthropic API key used by the agent core (dry-run endpoint, playground).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: enables address search + map in the playground
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk....

# Optional: where the agent reads the archive (must be publicly reachable —
# the MCP connector calls it from Anthropic's side). Defaults to production;
# point at a preview deployment to test unreleased MCP features.
# NOTIS_MCP_URL=https://opencouncil.gr/mcp
# Optional: main-app base URL for the REST proxies (cities, topics).
# OPENCOUNCIL_BASE_URL=https://opencouncil.gr

# Notis's own database. Optional: without it the service runs stateless
# (playground-only mode; the admin panel shows honest zeros).
# NOTIS_DATABASE_URL=postgresql://notis:notis@localhost:5433/notis

# Main-database connection for the notis_* views. Use a login user in the
# notis_reader role (see the ops note in README.md). Optional: without it
# cookie auth fails closed and the playground hides the real-user picker.
# MAIN_DATABASE_URL=postgresql://notis_service:...@localhost:5432/development

# Override for the main app's session cookie name (defaults per environment;
# see src/lib/session-auth.ts).
# MAIN_SESSION_COOKIE_NAME=authjs.session-token-3000

# The bearer token the main app presents on /api/subscriptions/* (the profile
# switch). Same value in the main app's NOTIS_SERVICE_TOKEN; at least 32
# characters (openssl rand -hex 32). Without it those routes answer 503.
# NOTIS_SERVICE_TOKEN=

# Enrollment pacing (see README.md). The cutoff is the ISO instant of the
# PR 5 production deploy: accounts from before it move over with
# demos_transition, younger ones sign up with notis_intro. Unset: everyone
# is a signup. Transitions are paced per five-minute tick; signups never wait.
# NOTIS_TRANSITION_CUTOFF=2026-09-15T10:00:00Z
# NOTIS_ENROLL_PER_TICK=2

# Bird (WhatsApp). All optional; see README.md, "Bird (WhatsApp)". The
# template ids are Bird project UUIDs, one per shell in src/agent/templates.ts.
# BIRD_API_KEY=
# BIRD_WORKSPACE_ID=
# BIRD_WHATSAPP_CHANNEL_ID=
# BIRD_SMS_CHANNEL_ID=
# BIRD_WEBHOOK_SECRET=
# BIRD_WHATSAPP_TEMPLATE_DEMOS_TRANSITION=
# BIRD_WHATSAPP_TEMPLATE_NOTIS_INTRO=
# BIRD_WHATSAPP_TEMPLATE_DEMOS_INTRO=
# BIRD_WHATSAPP_TEMPLATE_DEMOS_UPDATE_AGENDA=
# BIRD_WHATSAPP_TEMPLATE_DEMOS_UPDATE_NEWS=
# BIRD_WHATSAPP_TEMPLATE_DEMOS_FOLLOWUP=
