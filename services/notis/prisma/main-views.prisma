// Typed read access to the main database's notis_* views — the only surface
// Notis has into the main app. The connection user belongs to notis_reader,
// which can SELECT the five views and nothing else, so this client physically
// cannot write the main database.
//
// Generate-only: the views are owned by the ROOT prisma migration history
// (prisma/migrations/20260815120000_notis_views_and_rollout; notis_fanout_targets
// and notis_meeting_events last replaced in
// 20261009150000_notification_preference_bodies, which adds the bodies a
// reader follows and the body an event belongs to, #829). A column added
// here is required at read time, so the main database migrates before the
// Notis build that reads the column deploys. Never run migrate against this
// schema.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/main-client"
}

datasource db {
  provider = "postgresql"
  url      = env("MAIN_DATABASE_URL")
}

model NotisUserRow {
  id             String    @id
  name           String?
  phone          String?
  createdAt      DateTime
  updatedAt      DateTime

  @@map("notis_users")
}

model FanoutTargetRow {
  userId         String
  userName       String?
  phone          String?
  notifyByPhone  Boolean
  cityId         String
  cityName       String
  cityNameEn     String
  realm          String
  language       String
  timezone       String
  // [{id, name, name_en}]
  topics    Json
  // [{text, type, lng, lat}] — lng/lat are centroid coordinates, null-able
  locations Json
  updatedAt DateTime
  // [{id, name, name_en}]: the bodies of the city the reader follows on
  // their own (#829). An event with followersOnly reaches these readers alone.
  bodies    Json

  @@id([userId, cityId])
  @@map("notis_fanout_targets")
}

model MeetingEventRow {
  taskId        String   @id
  type          String
  completedAt   DateTime
  cityId        String
  meetingId     String
  // The name override only. Null means that the title is derived from
  // meetingKind and sessionNumber (@opencouncil/ui/lib/meeting-title).
  meetingName   String?
  meetingDate   DateTime
  released      Boolean
  adminBodyName String?
  realm         String
  language      String
  timezone      String
  meetingKind   String?
  sessionNumber Int?
  adminBodyId   String?
  // The body is one a reader follows on their own (#829): the audience is
  // the followers of adminBodyId, not every subscriber of the city.
  followersOnly Boolean

  @@map("notis_meeting_events")
}

model SessionRow {
  // SHA-256 of the Auth.js session token — the raw token never leaves the
  // main app.
  sessionTokenHash String   @id
  userId           String
  expires          DateTime

  @@map("notis_sessions")
}

model AdminSessionRow {
  sessionTokenHash String   @id
  userId           String
  expires          DateTime
  userName         String?

  @@map("notis_admin_sessions")
}
