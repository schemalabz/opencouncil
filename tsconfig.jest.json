    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".claude/skills/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "result",
    "result-*",
    "services"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["jest", "@testing-library/jest-dom"]
  }
}
